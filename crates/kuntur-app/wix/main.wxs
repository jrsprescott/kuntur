<?xml version='1.0' encoding='utf-8'?>
<!--
  Instalador MSI de Kuntur (F11). WiX Toolset v3 vía `cargo wix`:

      cargo build -p kuntur-app -p kuntur-hook (perfil release)
      cargo wix -p kuntur-app (con no-build, porque los dos binarios ya están compilados)
  El comando exacto está en scripts/msi.ps1.

  Variables que pone `cargo wix`: Version (de Cargo.toml), CargoTargetBinDir (target\release), etc.

  Qué instala (por máquina, en Program Files\Kuntur):
  - kuntur.exe y kuntur-hook.exe (los ganchos de Claude Code apuntan al que está junto a kuntur.exe),
    el ícono y las dos licencias.
  - Acceso en el menú Inicio con el AppUserModelID Kuntur.Kuntur, y ese AUMID registrado en
    HKLM\Software\Classes\AppUserModelId (nombre e ícono): las notificaciones dicen "Kuntur".
  Desinstalar quita todo lo anterior. No toca la configuración ni los datos del usuario
  (%APPDATA%\Kuntur) ni los ganchos instalados en ~/.claude (se quitan desde Kuntur antes).
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>
<?define Assets = "$(sys.SOURCEFILEDIR)..\..\..\assets" ?>
<?define Root = "$(sys.SOURCEFILEDIR)..\..\.." ?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
    <Product
        Id='*'
        Name='Kuntur'
        UpgradeCode='56DDC03F-821A-4FEC-A00A-9EE8EE53A2A4'
        Manufacturer='Kuntur'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>
        <!-- InstallerVersion 500: la tabla MsiShortcutProperty (AUMID del acceso directo). -->
        <Package Id='*'
            Keywords='Installer'
            Description='Kuntur: lightweight Windows terminal for AI coding agents'
            Manufacturer='Kuntur'
            InstallerVersion='500'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />
        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>
        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes'/>

        <Icon Id='KunturIco' SourceFile='$(var.Assets)\kuntur.ico'/>
        <Property Id='ARPPRODUCTICON' Value='KunturIco'/>
        <Property Id='ARPHELPLINK' Value='https://github.com/jrsprescott/kuntur'/>
        <Property Id='ARPURLINFOABOUT' Value='https://github.com/jrsprescott/kuntur'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='Kuntur'>
                    <Component Id='KunturExe' Guid='09B72904-DB5C-4308-A2D7-BEF5132D3C30'>
                        <File
                            Id='KunturExeFile'
                            Name='kuntur.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\kuntur.exe'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='KunturHookExe' Guid='*'>
                        <File
                            Id='KunturHookExeFile'
                            Name='kuntur-hook.exe'
                            DiskId='1'
                            Source='$(var.CargoTargetBinDir)\kuntur-hook.exe'
                            KeyPath='yes'/>
                    </Component>
                    <Component Id='KunturIcon' Guid='*'>
                        <File Id='KunturIcoFile' Name='kuntur.ico' DiskId='1' Source='$(var.Assets)\kuntur.ico' KeyPath='yes'/>
                    </Component>
                    <Component Id='LicenseMitTxt' Guid='*'>
                        <File Id='LicenseMit' Name='LICENSE-MIT.txt' DiskId='1' Source='$(var.Root)\LICENSE-MIT' KeyPath='yes'/>
                    </Component>
                    <Component Id='LicenseApacheTxt' Guid='*'>
                        <File Id='LicenseApache' Name='LICENSE-APACHE.txt' DiskId='1' Source='$(var.Root)\LICENSE-APACHE' KeyPath='yes'/>
                    </Component>
                    <!-- AUMID registrado: nombre e ícono de las notificaciones de Windows. -->
                    <Component Id='AppUserModelId' Guid='DB0E26C2-42C7-45A0-BB12-349687963779'>
                        <RegistryKey Root='HKLM' Key='Software\Classes\AppUserModelId\Kuntur.Kuntur' ForceDeleteOnUninstall='yes'>
                            <RegistryValue Type='string' Name='DisplayName' Value='Kuntur' KeyPath='yes'/>
                            <RegistryValue Type='string' Name='IconUri' Value='[APPLICATIONFOLDER]kuntur.ico'/>
                        </RegistryKey>
                    </Component>
                </Directory>
            </Directory>
            <!-- Acceso del menú Inicio (de todos los usuarios: instalación por máquina). La clave de
                 HKCU es solo la KeyPath que pide Windows Installer (ICE43/ICE57) y se borra al desinstalar. -->
            <Directory Id='ProgramMenuFolder'>
                <Component Id='StartMenuShortcut' Guid='*'>
                    <Shortcut
                        Id='StartMenuShortcut'
                        Name='Kuntur'
                        Description='Terminal for AI coding agents'
                        Target='[APPLICATIONFOLDER]kuntur.exe'
                        WorkingDirectory='APPLICATIONFOLDER'
                        Icon='KunturIco'
                        IconIndex='0'>
                        <ShortcutProperty Key='System.AppUserModel.ID' Value='Kuntur.Kuntur'/>
                    </Shortcut>
                    <RegistryValue Root='HKCU' Key='Software\Kuntur\Installer' Name='StartMenuShortcut' Type='integer' Value='1' KeyPath='yes'/>
                    <RemoveRegistryKey Root='HKCU' Key='Software\Kuntur\Installer' Action='removeOnUninstall'/>
                </Component>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Kuntur'
            Description='Kuntur, kuntur-hook and the Start menu shortcut.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Absent='disallow'>
            <ComponentRef Id='KunturExe'/>
            <ComponentRef Id='KunturHookExe'/>
            <ComponentRef Id='KunturIcon'/>
            <ComponentRef Id='LicenseMitTxt'/>
            <ComponentRef Id='LicenseApacheTxt'/>
            <ComponentRef Id='AppUserModelId'/>
            <ComponentRef Id='StartMenuShortcut'/>
        </Feature>
        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <!-- Interfaz: bienvenida → carpeta → instalar (sin página de licencia: MIT OR Apache-2.0). -->
        <Property Id='WIXUI_INSTALLDIR' Value='APPLICATIONFOLDER'/>
        <UI>
            <UIRef Id='WixUI_InstallDir'/>
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='InstallDirDlg' Order='99'>1</Publish>
            <Publish Dialog='InstallDirDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>
    </Product>
</Wix>
